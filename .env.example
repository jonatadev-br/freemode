# FREEMODE — Variáveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha os valores. Nunca comite o .env real.

# API do servidor (OpenRouter — usado quando a chave do caller não é fornecida)
OPENROUTER_API_KEY=sk-or-v1-...

# Chave de autenticação da própria API FREEMODE (Bearer token que callers enviam)
FREEMODE_API_KEY=sk-fm-...

# Múltiplas chaves de API (alternativa a FREEMODE_API_KEY), separadas por vírgula
# FREEMODE_API_KEYS=sk-fm-aaa,sk-fm-bbb,sk-fm-ccc

# Mapeamento de chave -> tier (formato: tier:chave,tier:chave)
# FREEMODE_TIER_KEYS=enterprise:sk-fm-ent-xxx,pro:sk-fm-pro-yyy

# Limites de rate limit (valores padrão se omitidos)
# RATE_LIMIT_TOTAL=5
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=50

# Origens permitidas pelo CORS. Use '*' apenas em dev/self-hosted atrás de proxy.
# Em produção defina a origem exata, ex: https://seu-dominio.com
CORS_ORIGIN=https://seu-dominio.com

# URL do espaço HuggingFace (adicionado automaticamente ao CORS se definido)
# HF_SPACE_URL=https://seu-usuario.spaces.hf.space

# Token e repositório para auto-publicação de datasets no HuggingFace
# HF_TOKEN=hf_...
# HF_DATASET_REPO=seu-usuario/seu-dataset

# Porta da API (padrão 7860, esperado pelo Hugging Face Spaces)
PORT=7860
